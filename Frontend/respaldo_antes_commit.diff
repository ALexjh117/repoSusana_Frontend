+  margin-top: 4px;
+  color: var(--muted);
+  font-size: 9px;
+}
+
+.ai-card-note {
+  margin-top: 11px !important;
+  padding-top: 9px;
+  border-top: 1px solid #e1ece6;
+  color: var(--muted);
+  font-size: 9px;
+  line-height: 1.4;
+}
+
+.ai-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 5px;
+  margin-top: 11px;
+}
+
+.ai-actions button {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  border: 0;
+  border-radius: 8px;
+  padding: 6px 8px;
+  background: #e8f5ed;
+  color: var(--green);
+  font-size: 9px;
+  font-weight: 800;
+  transition: background-color 160ms ease, transform 160ms var(--ease-out);
+}
+
+.ai-actions button span {
+  font-size: 13px;
+  line-height: 0.7;
+}
+
+.ai-actions button:hover {
+  background: #d8eee1;
+}
+
+.ai-actions button:active {
+  transform: scale(0.97);
+}
+
+.ai-trend-value {
+  display: flex;
+  align-items: baseline;
+  gap: 5px;
+}
+
+.ai-trend-value strong {
+  color: var(--green-deep);
+  font-size: 24px;
+  font-weight: 850;
+  letter-spacing: -0.06em;
+}
+
+.ai-trend-value span {
+  color: var(--muted);
+  font-size: 10px;
+}
+
+.ai-sparkline {
+  display: block;
+  width: 100%;
+  height: 88px;
+  margin-top: 5px;
+  overflow: visible;
+}
+
+.ai-sparkline path {
+  fill: none;
+  stroke: #dcebe3;
+  stroke-width: 1;
+}
+
+.ai-sparkline polyline {
+  fill: none;
+  stroke: var(--green);
+  stroke-width: 2.5;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+
+.ai-sparkline circle {
+  fill: #fff;
+  stroke: var(--green);
+  stroke-width: 2;
+}
+
+.ai-table-scroll {
+  overflow-x: auto;
+  border: 1px solid #e1ece6;
+  border-radius: 10px;
+}
+
+.ai-table {
+  width: 100%;
+  min-width: 340px;
+  border-collapse: collapse;
+  background: #fff;
+}
+
+.ai-table th,
+.ai-table td {
+  padding: 8px 9px;
+  border-bottom: 1px solid #e7efea;
+  color: var(--green-deep);
+  font-size: 9px;
+  text-align: left;
+  white-space: nowrap;
+}
+
+.ai-table th {
+  background: #f1f7f3;
+  color: var(--muted);
+  font-size: 8px;
+  font-weight: 800;
+}
+
+.ai-table tr:last-child td {
+  border-bottom: 0;
+}
+
+.ai-alert-card,
+.ai-insight-card,
+.ai-forecast-card,
+.ai-simulation-card,
+.ai-recommendation-card {
+  background: #fbfdfb;
+}
+
+.ai-alert-card.ai-tone-amber { border-color: #f0dfbf; }
+.ai-alert-card.ai-tone-red { border-color: #f0d2cc; }
+
+.ai-alert-text,
+.ai-insight-text {
+  color: var(--green-deep);
+  font-size: 11px;
+  line-height: 1.5;
+}
+
+.ai-simulation-scenario {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 8px;
+  margin-bottom: 10px;
+  padding: 9px 10px;
+  border-radius: 10px;
+  background: #eef8f2;
+}
+
+.ai-simulation-scenario span {
+  color: var(--muted);
+  font-size: 9px;
+}
+
+.ai-simulation-scenario strong {
+  color: var(--green-deep);
+  font-size: 12px;
+}
+
+.ai-simulation-options {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 5px;
+  margin-top: 11px;
+}
+
+.ai-recommendation-list {
+  display: grid;
+  gap: 8px;
+  margin: 0;
+  padding-left: 19px;
+  color: var(--green-deep);
+  font-size: 10px;
+  line-height: 1.4;
+}
+
+.ana-composer {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 12px 14px 8px;
+  border-top: 1px solid #e4eee9;
+  background: #fff;
+}
+
+.ana-composer input {
+  min-width: 0;
+  flex: 1;
+  height: 43px;
+  border: 1px solid #d5e7dd;
+  border-radius: 12px;
+  padding: 10px 12px;
+  outline: 0;
+  background: #f8fbf9;
+  color: var(--green-deep);
+  font-size: 12px;
+}
+
+.ana-composer input::placeholder {
+  color: #8ba198;
+}
+
+.ana-composer input:focus {
+  border-color: #7fc29e;
+  background: #fff;
+  box-shadow: 0 0 0 3px rgba(91, 177, 129, 0.12);
+}
+
+.ana-send {
+  display: grid;
+  place-items: center;
+  width: 43px;
+  height: 43px;
+  flex: none;
+  border: 0;
+  border-radius: 50%;
+  background: var(--green);
+  color: #fff;
+  box-shadow: 0 6px 13px rgba(20, 135, 92, 0.19);
+  transition: background-color 160ms ease, transform 160ms var(--ease-out);
+}
+
+.ana-send svg {
+  width: 18px;
+  height: 18px;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1.9;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+
+.ana-send:disabled {
+  opacity: 0.55;
+}
+
+.ana-send:active {
+  transform: scale(0.94);
+}
+
+.ana-disclaimer {
+  padding: 0 15px 10px;
+  color: #84978e;
+  font-size: 9px;
+  text-align: center;
+}
+
+.ana-robot {
+  position: fixed;
+  z-index: 55;
+  right: 22px;
+  bottom: 22px;
+  display: grid;
+  place-items: center;
+  width: 62px;
+  height: 62px;
+  border: 0;
+  border-radius: 50%;
+  padding: 0;
+  background: #14875c;
+  box-shadow: 0 12px 25px rgba(14, 90, 62, 0.28);
+  transition: transform 180ms var(--ease-out), box-shadow 180ms ease, background-color 180ms ease;
+}
+
+.ana-robot .robot-svg {
+  width: 49px;
+  height: 49px;
+}
+
+.ana-robot:hover {
+  background: #0f7450;
+  box-shadow: 0 15px 29px rgba(14, 90, 62, 0.34);
+  transform: translateY(-2px);
+}
+
+.ana-robot:active {
+  transform: scale(0.95);
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .ana-chat-icon-btn:hover {
+    background: var(--mint);
+  }
+
+  .ana-send:hover {
+    background: #0f7450;
+  }
+}
+
+@media (max-width: 1180px) {
+  .ana-chat-panel {
+    right: 14px;
+    width: min(420px, calc(100vw - 28px));
+  }
+}
+
+@media (max-width: 640px) {
+  .ana-chat-panel {
+    top: 72px;
+    right: 10px;
+    bottom: 72px;
+    width: calc(100vw - 20px);
+    border-radius: 21px;
+  }
+
+  .ana-chat-head {
+    min-height: 68px;
+    padding: 12px 13px;
+  }
+
+  .ana-chat-avatar {
+    width: 39px;
+    height: 39px;
+  }
+
+  .ana-chat-avatar .robot-svg {
+    width: 31px;
+    height: 31px;
+  }
+
+  .ana-chat-name > strong {
+    font-size: 14px;
+  }
+
+  .ana-chat-name > span:not(.ana-chat-status) {
+    max-width: 190px;
+    font-size: 9px;
+  }
+
+  .ana-thread {
+    padding-inline: 11px;
+  }
+
+  .ana-suggestions,
+  .ana-typing {
+    margin-left: 37px;
+  }
+
+  .ai-kpi-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 4px;
+  }
+
+  .ai-kpi {
+    padding: 8px 7px;
+  }
+
+  .ai-kpi > strong {
+    font-size: 16px;
+  }
+
+  .ai-card-head h3 {
+    font-size: 12px;
+  }
+
+  .ana-robot {
+    right: 16px;
+    bottom: 16px;
+    width: 58px;
+    height: 58px;
+  }
+
+  .ana-robot .robot-svg {
+    width: 46px;
+    height: 46px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .ana-chat-panel {
+    transform: none;
+    transition: opacity 160ms ease, visibility 0s linear 160ms;
+  }
+
+  .ana-chat-panel[data-open="true"] {
+    transition: opacity 160ms ease, visibility 0s;
+  }
+
+  .ai-visual-card,
+  .ana-typing-dots i,
+  .ana-chat-icon-btn,
+  .ana-send,
+  .ana-robot {
+    animation: none;
+    transition: none;
+  }
+}
